{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "OnlineLearningPlatform",
      "Audience": "OnlineLearningPlatform.AngularClient",
      "AccessTokenMinutes": 15
    }
  },
  "Email": {
    "FromAddress": "no-reply@online-learning-platform.local",
    "FromName": "Online Learning Platform",
    "VerificationPageUrl": "http://localhost:4200/verify-email",
    "PasswordResetPageUrl": "http://localhost:4200/reset-password",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseStartTls": true
    }
  },
  "AllowedHosts": "*"
}
