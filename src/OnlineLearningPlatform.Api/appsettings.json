{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "OnlineLearningPlatform",
      "Audience": "OnlineLearningPlatform.AngularClient",
      "AccessTokenMinutes": 15
    }
  },
  "Email": {
    "From": "your-account@gmail.com",
    "AppUrl": "http://localhost:4200",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 465,
      "Secure": true
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
