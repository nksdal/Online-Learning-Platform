# Copy to .env.production on the Droplet, chmod 600, and replace every placeholder.
# Use URL-safe passwords (letters, digits, underscore) because connection strings use semicolons.

# Public app hostname. Point its DNS A record at the Droplet; Caddy will request HTTPS automatically.
SITE_HOST=app.example.com
FRONTEND_ORIGIN=https://app.example.com
APP_URL=https://app.example.com

# SQL hostname must match the DNS SAN on the publicly trusted SQL TLS certificate.
# SQLSERVER_HOSTNAME is also a private Docker network alias; do not expose TCP/1433 publicly.
SQLSERVER_HOSTNAME=db.example.com
SQLSERVER_TLS_CERT_PATH=/etc/ssl/nikladori/db-fullchain.pem
SQLSERVER_TLS_KEY_PATH=/etc/ssl/nikladori/db-private-key.pem
PROXY_NETWORK_SUBNET=172.28.0.0/24
CADDY_PROXY_IP=172.28.0.2

# Host paths for durable database and backup files.
SQLSERVER_DATA_DIR=/srv/nikladori/sqlserver
SQL_BACKUP_DIR=/srv/nikladori/backups

# Generate unique secrets for this deployment. Never reuse local development values.
MSSQL_SA_PASSWORD=Replace_With_A_Strong_SQL_Admin_Password_123!
DB_APP_PASSWORD=Replace_With_A_Different_App_Password_456!
DB_MIGRATOR_PASSWORD=Replace_With_A_Different_Migration_Password_789!
JWT_SIGNING_KEY=Replace_With_At_Least_32_Random_Bytes

# Optional bootstrap administrator. Remove/comment both variables after the first admin is created.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Replace_With_A_Strong_Admin_Password_123!

# Email sender. Gmail SMTP is a stopgap; use a verified sender for a public launch.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-account@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=your-account@gmail.com

# Optional Cloudinary media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
