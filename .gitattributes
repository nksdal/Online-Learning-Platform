# Let Git normalise line endings for text files.
* text=auto

# Files that run inside Linux containers must keep LF endings even when checked out on Windows.
*.sh         text eol=lf
Dockerfile   text eol=lf
*.dockerfile text eol=lf
Caddyfile    text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary