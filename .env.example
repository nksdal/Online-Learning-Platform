# Copy this file to .env and replace every placeholder with your own values.
# SQL Server requires at least 8 characters and a mix of character classes.
MSSQL_SA_PASSWORD=ChangeMe_LocalOnly_123!
JWT_SIGNING_KEY=ReplaceWithAtLeast32RandomBytesForLocalDevelopment

# Optional: set both to create the initial Admin user. Keep these secrets out of Git.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# BOOTSTRAP_ADMIN_PASSWORD=Choose_A_Strong_Unique_Password_123

# Local development email through your Gmail account.
# Turn on Google 2-Step Verification, create an App Password, and use that password below.
# Keep the App Password only in this ignored .env file; never commit it or paste it into chat.
EMAIL_FROM_ADDRESS=your-account@gmail.com
EMAIL_FROM_NAME=Nikladori
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_STARTTLS=true
EMAIL_SMTP_USERNAME=your-account@gmail.com
EMAIL_SMTP_PASSWORD=

# Local callbacks work only on this computer; replace with your deployed frontend URLs for public users.
EMAIL_VERIFICATION_URL=http://localhost:4200/verify-email
EMAIL_PASSWORD_RESET_URL=http://localhost:4200/reset-password

# Local host ports. Services bind to 127.0.0.1 only.
API_HOST_PORT=5220
SQLSERVER_HOST_PORT=14330
