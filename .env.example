# Copy this file to .env and replace every placeholder with your own values.
# SQL Server requires at least 8 characters and a mix of character classes.
# Separate least-privilege account used by the running API; do not reuse the SQL Server administrator password.
DB_APP_PASSWORD=Choose_A_Different_Strong_Database_Password_456
MSSQL_SA_PASSWORD=ChangeMe_LocalOnly_123!
JWT_SIGNING_KEY=ReplaceWithAtLeast32RandomBytesForLocalDevelopment

# The Development Compose stack seeds 9 demo courses, 45 lessons, and 18 assignments by default.
DEMO_CATALOG_ENABLED=true

# Optional: set both to create the initial Admin user. Keep these secrets out of Git.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# BOOTSTRAP_ADMIN_PASSWORD=Choose_A_Strong_Unique_Password_123

# Gmail SMTP email delivery. Use a dedicated Gmail account and an App Password, not your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-account@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=your-account@gmail.com
APP_URL=http://localhost:4200

# For phone testing on the same Wi-Fi, set this to the PC's private IPv4 address.
# Keep the API bound to all interfaces so the phone can reach it; this is for local development only.
# Add the same phone-test IP to ALLOWED_HOSTS below.
FRONTEND_HOST=192.168.1.50
API_BIND_ADDRESS=0.0.0.0
ALLOWED_HOSTS=localhost;127.0.0.1;[::1];192.168.1.50
# For phone testing, change APP_URL above to http://192.168.1.50:4200.

# Optional profile photo storage. Create a Cloudinary account, then copy these from its API credentials.
# Uploads are disabled until all three values are set. Keep the API secret only in the ignored .env file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local host ports.
API_HOST_PORT=5220
SQLSERVER_HOST_PORT=14330
